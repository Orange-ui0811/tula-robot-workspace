{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "运行当前打开的 Python 脚本",
            "type": "python",
            "request": "launch",
            "program": "${file}", // 核心修改：动态获取当前打开的 Python 文件
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "GDB 真机诊断（会运行 C 测试）",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_hardware_c.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/tests",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb", 
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build C Test Executable"
        }
    ]
}
